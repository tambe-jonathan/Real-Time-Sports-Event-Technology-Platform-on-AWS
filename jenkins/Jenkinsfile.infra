pipeline {
    agent any

    environment {
        AWS_REGION = 'us-east-1' //  EDIT THIS: If your base state/infra uses a different region
        TF_DIR     = 'infrastructure/environments/dev'
    }

    stages {
        stage('Checkout Infrastructure Code') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init & Validate') {
            steps {
                //  Injected stored AWS credentials to authenticate with S3 Backends & APIs
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding', 
                    credentialsId: 'aws-credentials'
                ]]) {
                    dir("${TF_DIR}") {
                        sh 'terraform init'
                        sh 'terraform validate'
                    }
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding', 
                    credentialsId: 'aws-credentials'
                ]]) {
                    dir("${TF_DIR}") {
                        // Saves the execution plan safely to an artifact file
                        sh 'terraform plan -out=tfinfra.plan'
                    }
                }
            }
        }

        stage('Approval Gate') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: 'Apply infrastructure changes to AWS?', ok: 'Apply'
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding', 
                    credentialsId: 'aws-credentials'
                ]]) {
                    dir("${TF_DIR}") {
                        // Applies the exact plan validated and approved above
                        sh 'terraform apply -input=false tfinfra.plan'
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Foundational Infrastructure deployed successfully. Handing off orchestration to Application Pipeline...'
            
            //  AUTOMATED TRIGGER: Intercepts success state to trigger Pipeline #2
            //  EDIT THIS: Replace 'EventPulse-App-Deployment' with your EXACT application pipeline job name in Jenkins
            build job: 'EventPulse-App-Deployment', wait: false
        }
        always {
            cleanWs()
        }
    }
}
