pipeline {
    agent any

    environment {
        AWS_REGION = 'us-east-1'
        TF_DIR     = 'infrastructure/environments/dev'
    }

    stages {
        stage('Checkout Infrastructure Code') {
            steps {
                checkout scm
            }
        }

        stage('Bootstrap Terraform Backend') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                    // Navigate to where your bootstrap file lives and execute it
                    // Assuming it's a shell script located in your root or infrastructure folder
                    sh '''
                        chmod +x bootstrap/start-backend.sh
                        ./bootstrap/start-backend.sh
                    '''
                }
            }
        }

        stage('Terraform Init & Validate') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                    dir("${TF_DIR}") {
                        // Now that the bootstrap stage has guaranteed the S3 bucket exists, 
                        // init will successfully connect to the remote backend
                        sh 'terraform init'
                        sh 'terraform validate'
                    }
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                    dir("${TF_DIR}") {
                        sh '''
                            terraform plan \
                            -var='score_image_tag=vInitial' \
                            -var='athlete_image_tag=vInitial' \
                            -var='leaderboard_image_tag=vInitial' \
                            -out=tfinfra.plan
                        '''
                    }
                }
            }
        }

        stage('Approval Gate') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: 'Apply infrastructure changes to AWS?', ok: 'Apply'
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                    dir("${TF_DIR}") {
                        sh 'terraform apply -input=false tfinfra.plan'
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Foundational Infrastructure deployed successfully. Handing off orchestration to Application Pipeline...'
            build job: 'EventPulse-App-Deployment', wait: false
        }
        always {
            cleanWs()
        }
    }
}
