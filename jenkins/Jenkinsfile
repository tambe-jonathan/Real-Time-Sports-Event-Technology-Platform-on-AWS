pipeline {
    agent any

    environment {
        AWS_REGION      = 'us-east-1'
        AWS_ACCOUNT_ID  = 'YOUR_AWS_ACCOUNT_ID' // Replace with your actual AWS Account ID
        ECR_REGISTRY    = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        TF_APP_DIR      = 'infrastructure/environments/dev'
        
        // Microservices mapping matching your structure
        SVC_1           = 'score-service'
        SVC_2           = 'athlete-service'
        SVC_3           = 'leaderboard-service'
        
        IMAGE_TAG       = "v${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Unit Tests') {
            parallel {
                stage('Score Service Tests') {
                    steps { sh 'cd applications/score-service && pip install -r requirements.txt && pytest' }
                }
                stage('Athlete Service Tests') {
                    steps { sh 'cd applications/athlete-service && pip install -r requirements.txt && pytest' }
                }
                stage('Leaderboard Service Tests') {
                    steps { sh 'cd applications/leaderboard-service && pip install -r requirements.txt && pytest' }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                withSonarQubeEnv('SonarQube-Server') {
                    sh 'sonar-scanner'
                }
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build & Scan Docker Images') {
            parallel {
                stage('Build Score Service') {
                    steps {
                        sh "docker build -t ${SVC_1}:${IMAGE_TAG} applications/${SVC_1}"
                        sh "trivy image --exit-code 1 --severity CRITICAL ${SVC_1}:${IMAGE_TAG}"
                    }
                }
                stage('Build Athlete Service') {
                    steps {
                        sh "docker build -t ${SVC_2}:${IMAGE_TAG} applications/${SVC_2}"
                        sh "trivy image --exit-code 1 --severity CRITICAL ${SVC_2}:${IMAGE_TAG}"
                    }
                }
                stage('Build Leaderboard Service') {
                    steps {
                        sh "docker build -t ${SVC_3}:${IMAGE_TAG} applications/${SVC_3}"
                        sh "trivy image --exit-code 1 --severity CRITICAL ${SVC_3}:${IMAGE_TAG}"
                    }
                }
            }
        }

        stage('Push Images to ECR') {
            steps {
                script {
                    sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"
                    
                    def services = [SVC_1, SVC_2, SVC_3]
                    for (svc in services) {
                        sh "docker tag ${svc}:${IMAGE_TAG} ${ECR_REGISTRY}/${svc}:${IMAGE_TAG}"
                        sh "docker push ${ECR_REGISTRY}/${svc}:${IMAGE_TAG}"
                    }
                }
            }
        }

        stage('Terraform Plan App Deploy') {
            steps {
                dir("${TF_APP_DIR}") {
                    sh 'terraform init'
                    // Re-run plan specifically updating the app tags for ECS task definitions
                    sh "terraform plan -var='score_image_tag=${IMAGE_TAG}' -var='athlete_image_tag=${IMAGE_TAG}' -var='leaderboard_image_tag=${IMAGE_TAG}' -out=tfapp.plan"
                }
            }
        }

        stage('Manual Deployment Approval') {
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    input message: "Approve rolling update deployment for version ${IMAGE_TAG} to ECS?", ok: 'Deploy'
                }
            }
        }

        stage('Terraform Apply ECS Update') {
            steps {
                dir("${TF_APP_DIR}") {
                    sh 'terraform apply -input=false tfapp.plan'
                }
            }
        }

        stage('Smoke Test') {
            steps {
                echo 'Checking service availability...'
                // Swap with your actual Application Load Balancer endpoint
                sh 'curl -f http://your-alb-dns-name/health || exit 1'
            }
        }
    }

    post {
        always {
            cleanWs()
            sh "docker rmi ${SVC_1}:${IMAGE_TAG} ${SVC_2}:${IMAGE_TAG} ${SVC_3}:${IMAGE_TAG} || true"
        }
    }
}
